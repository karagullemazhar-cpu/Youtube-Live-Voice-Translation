{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Youtube Live Voice Translation",
  "short_name": "LT",
  "version": "1.6.0",
  "description": "This AI application translates the current YouTube video realtime into Turkish or into your chosen language.",
  "permissions": [
    "storage",
    "tabCapture",
    "activeTab",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://dashscope-intl.aliyuncs.com/*",
    "wss://dashscope-intl.aliyuncs.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Youtube Live Voice Translation",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src wss://generativelanguage.googleapis.com wss://dashscope-intl.aliyuncs.com"
  }
}
